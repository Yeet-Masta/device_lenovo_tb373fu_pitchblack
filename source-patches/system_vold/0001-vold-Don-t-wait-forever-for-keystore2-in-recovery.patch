From 1e303235eb980f03c03e3a3fb4856f29b75f995f Mon Sep 17 00:00:00 2001
From: Yeet-Masta <153568286+Yeet-Masta@users.noreply.github.com>
Date: Sun, 1 Nov 2026 06:52:38 -0800
Subject: [PATCH] vold: Don't wait forever for keystore2 in recovery

AServiceManager_waitForService blocks until keystore2 registers, which in
recovery only happens if the device's KeyMint comes up. When it doesn't,
metadata decryption hangs and the recovery UI never leaves the splash.
Poll for up to 20 s instead and give up for the rest of the session; all
callers already handle an unconnected Keystore by failing the operation.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Keystore.cpp | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/Keystore.cpp b/Keystore.cpp
index 5012779..3a4a92c 100644
--- a/Keystore.cpp
+++ b/Keystore.cpp
@@ -18,6 +18,9 @@
 
 #include <android-base/logging.h>
 
+#include <chrono>
+#include <thread>
+
 #include <aidl/android/hardware/security/keymint/SecurityLevel.h>
 #include <aidl/android/security/maintenance/IKeystoreMaintenance.h>
 #include <aidl/android/system/keystore2/Domain.h>
@@ -104,7 +107,21 @@ bool KeystoreOperation::finish(std::string* output) {
 }
 
 Keystore::Keystore() {
-    ::ndk::SpAIBinder binder(AServiceManager_waitForService(keystore2_service_name));
+    // In recovery, keystore2 only comes up if the device's KeyMint does. Wait
+    // a bounded time instead of forever, so a broken TEE leaves /data encrypted
+    // instead of hanging the UI; once it has timed out, don't wait again.
+    static bool sGaveUp = false;
+    ::ndk::SpAIBinder binder;
+    for (int i = 0; !sGaveUp && i < 200; i++) {
+        binder = ::ndk::SpAIBinder(AServiceManager_checkService(keystore2_service_name));
+        if (binder.get() != nullptr) break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+    if (binder.get() == nullptr) {
+        sGaveUp = true;
+        LOG(ERROR) << "Vold gave up waiting for keystore2.";
+        return;
+    }
     auto keystore2Service = ks2::IKeystoreService::fromBinder(binder);
 
     if (!keystore2Service) {
-- 
2.43.0

