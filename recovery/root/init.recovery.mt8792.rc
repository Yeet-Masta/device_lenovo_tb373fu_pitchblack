# TB373FU / TB375FC recovery init. The bootloader reports ro.hardware=mt8792,
# so init imports init.recovery.mt8792.rc (an mt6897-named file is never read).
#
# USB: GKI 6.1 MTK kernels only expose the configfs gadget, while the recovery
# init.rc defaults sys.usb.configfs to 0 in early-init. Flip it on in init and
# name the UDC (from stock A16 ROW init.recovery.mt8792.rc), as the LineageOS
# recovery on this device does.
on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop sys.usb.ffs.aio_compat 1

# Microsoft OS descriptors speed up Windows enumeration on adb/fastboot switches.
on boot && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
